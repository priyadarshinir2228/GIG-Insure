<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36" version="29.6.4">
  <diagram id="yPxyJZ8AM_hMuL3Unpa9" name="gitflow">
    <mxGraphModel dx="3160" dy="1991" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: {&#39;primaryColor&#39;: &#39;#DBEAFE&#39;, &#39;primaryTextColor&#39;: &#39;#1B3A6B&#39;, &#39;primaryBorderColor&#39;: &#39;#2563EB&#39;, &#39;lineColor&#39;: &#39;#2563EB&#39;, &#39;secondaryColor&#39;: &#39;#CCFBF1&#39;, &#39;tertiaryColor&#39;: &#39;#EDE9FE&#39;, &#39;background&#39;: &#39;#FFFFFF&#39;, &#39;nodeBorder&#39;: &#39;#2563EB&#39;, &#39;clusterBkg&#39;: &#39;#F3F4F6&#39;, &#39;clusterBorder&#39;: &#39;#9CA3AF&#39;, &#39;edgeLabelBackground&#39;: &#39;#FFFFFF&#39;, &#39;fontFamily&#39;: &#39;Arial&#39;}}}%%\n\nflowchart TD\n\n    %% ─── EXTERNAL ACTORS ───────────────────────────────────────────────────\n    CUSTOMER([\&quot;👤 Customer\&quot;])\n    WORKER([\&quot;🧑‍💼 Worker\\nMobile App\&quot;])\n    BANK([\&quot;🏦 Worker Bank\&quot;])\n\n    %% ─── FLOW 1: ORDER CYCLE ───────────────────────────────────────────────\n    subgraph F1[\&quot;FLOW 1 — Order Cycle\&quot;]\n        direction TB\n        F1A[\&quot;Platform API\\nOrder Validation\&quot;]\n        F1B[[\&quot;Kafka\\norder.placed\&quot;]]\n        F1C[\&quot;GPS Service\\nLive Tracking\&quot;]\n        F1D[\&quot;Delivery Engine\\nCompletion Capture\&quot;]\n        F1E[\&quot;Razorpay\\nPayment Capture\&quot;]\n    end\n\n    %% ─── FLOW 2: SALARY TRANSFER ───────────────────────────────────────────\n    subgraph F2[\&quot;FLOW 2 — Salary Transfer\&quot;]\n        direction TB\n        F2A[\&quot;⏰ Sunday Cron\\nEarnings Calculation\&quot;]\n        F2B[\&quot;Premium Engine\\nNCD + Loading Deduction\&quot;]\n        F2C[(\&quot;PostgreSQL\\nEarnings Pool\&quot;)]\n        F2D[[\&quot;Kafka\\nsalary.transfer\&quot;]]\n        F2E[\&quot;Razorpay\\nUPI Payout\&quot;]\n        F2F[\&quot;Twilio / SendGrid\\nSMS + Email Confirm\&quot;]\n    end\n\n    %% ─── FLOW 3: KYC + DIGILOCKER ─────────────────────────────────────────\n    subgraph F3[\&quot;FLOW 3 — KYC + DigiLocker\&quot;]\n        direction TB\n        F3A[\&quot;SHA-256\\nAadhaar Hash\&quot;]\n        F3B[\&quot;DigiLocker\\nOAuth 2.0 Verify\&quot;]\n        F3C[\&quot;NPCI\\nUPI VPA Validate\&quot;]\n        F3D[\&quot;KYC Engine\\nTrust Score 1.00\&quot;]\n        F3E[\&quot;Guidewire\\nPolicyCenter\&quot;]\n    end\n\n    %% ─── FLOW 4: PREMIUM CALCULATION ───────────────────────────────────────\n    subgraph F4[\&quot;FLOW 4 — Premium Calculation\&quot;]\n        direction TB\n        F4A[\&quot;Apache Spark\\nFetch W_avg 12-week\&quot;]\n        F4B[\&quot;Coverage Engine\\n1.5 × W_avg\&quot;]\n        F4C[\&quot;XGBoost\\nRisk Score Rᵢ\&quot;]\n        F4D[\&quot;Zone Service\\nSeasonal Loading +0–50%\&quot;]\n        F4E[\&quot;Guidewire\\nBillingCenter\\nStore Final Premium\&quot;]\n    end\n\n    %% ─── FLOW 5: INSURANCE REGISTRATION ────────────────────────────────────\n    subgraph F5[\&quot;FLOW 5 — Insurance Registration\&quot;]\n        direction TB\n        F5A[[\&quot;Kafka\\ninsurance.registered\&quot;]]\n        F5B[(\&quot;PostgreSQL\\nPolicy Metadata\&quot;)]\n        F5C[\&quot;Guidewire\\nPolicyCenter\\nActivate Policy\&quot;]\n        F5D[\&quot;PDF Service\\nDigital Certificate\\nIssued In-App\&quot;]\n    end\n\n    %% ─── FLOW 6: SITUATION ENGINE ───────────────────────────────────────────\n    subgraph F6[\&quot;FLOW 6 — Situation Event Detection\&quot;]\n        direction TB\n        F6A[\&quot;IMD / NDMA APIs\\nSTFI Events\\nFlood · Cyclone · Rain · Heat · Fog\&quot;]\n        F6B[\&quot;News / Police APIs\\nRSMD Events\\nBandh · Strike · Curfew · Unrest\&quot;]\n        F6C{\&quot;Dual-Source\\nConfirmation?\&quot;}\n        F6D[\&quot;Geofencing Service\\nZone Match\&quot;]\n        F6E[\&quot;Income Checker\\nEarnings Drop Verified\&quot;]\n    end\n\n    %% ─── FLOW 7: CLAIM FLOW ─────────────────────────────────────────────────\n    subgraph F7[\&quot;FLOW 7 — Claim Flow\&quot;]\n        direction TB\n        F7A[[\&quot;Kafka\\nclaim.raised\&quot;]]\n        F7B[\&quot;Apache Spark\\nFetch Actual Earnings\&quot;]\n        F7C[(\&quot;PostgreSQL\\nCLM Record Created\&quot;)]\n        F7D[\&quot;Guidewire\\nClaimCenter\\nClaim Shell Opened\&quot;]\n        F7E[\&quot;Twilio / FCM\\nWorker Notified\&quot;]\n    end\n\n    %% ─── FLOW 8: AI DECISION ENGINE ─────────────────────────────────────────\n    subgraph F8[\&quot;FLOW 8 — AI Decision Engine\&quot;]\n        direction TB\n        F8A[\&quot;LangChain\\nOrchestrator\&quot;]\n        subgraph PARALLEL[\&quot;Parallel Agents\&quot;]\n            direction LR\n            A1[\&quot;A1\\nGPS Fraud\\nDetection\&quot;]\n            A2[\&quot;A2\\nKYC Financial\\nCross-check\&quot;]\n            A3[\&quot;A3\\nAPI Event\\nVerification\&quot;]\n        end\n        F8B[\&quot;A4 Decision Agent\\nPayout = 70% × Loss\&quot;]\n        F8C{\&quot;Cap + Pool\\nReserve Check\&quot;}\n        F8D[\&quot;SHAP\\nExplainability\&quot;]\n        F8E{{\&quot;Auto-Approve\\n/ Flag / Reject\&quot;}}\n    end\n\n    %% ─── FLOW 9: FUND TRANSFER ──────────────────────────────────────────────\n    subgraph F9[\&quot;FLOW 9 — Fund Transfer\&quot;]\n        direction TB\n        F9A[\&quot;Razorpay\\nUPI Payout API\&quot;]\n        F9B[\&quot;NPCI\\nUPI Rail → UTR\&quot;]\n        F9C[(\&quot;PostgreSQL\\n5 Atomic DB Writes\\nstatus · amount · UTR · timestamp · pool\&quot;)]\n        F9D[\&quot;WhatsApp / SMS / Email\\nWorker Notification\&quot;]\n        F9E[\&quot;Guidewire\\nBillingCenter\\nClaim Closed\&quot;]\n        F9F[\&quot;Jira API\\nTicket Resolved\&quot;]\n    end\n\n    %% ─── CONNECTIONS: FLOW 1 ────────────────────────────────────────────────\n    CUSTOMER --&gt;|\&quot;places order\&quot;| F1A\n    F1A --&gt;|\&quot;validates\&quot;| F1B\n    F1B --&gt;|\&quot;dispatches\&quot;| F1C\n    F1C --&gt;|\&quot;streams GPS\&quot;| WORKER\n    F1C --&gt;|\&quot;delivery done\&quot;| F1D\n    F1D --&gt;|\&quot;triggers payment\&quot;| F1E\n\n    %% ─── CONNECTIONS: FLOW 2 ────────────────────────────────────────────────\n    F2A --&gt;|\&quot;calculates net pay\&quot;| F2B\n    F2B --&gt;|\&quot;updates pool\&quot;| F2C\n    F2C --&gt;|\&quot;fires event\&quot;| F2D\n    F2D --&gt;|\&quot;initiates payout\&quot;| F2E\n    F2E --&gt;|\&quot;credits\&quot;| BANK\n    F2E --&gt;|\&quot;confirms\&quot;| F2F\n    F2F --&gt;|\&quot;notifies\&quot;| WORKER\n\n    %% ─── CONNECTIONS: FLOW 3 ────────────────────────────────────────────────\n    WORKER --&gt;|\&quot;submits Aadhaar\&quot;| F3A\n    F3A --&gt;|\&quot;hashed ID\&quot;| F3B\n    F3B --&gt;|\&quot;verified identity\&quot;| F3C\n    F3C --&gt;|\&quot;VPA valid\&quot;| F3D\n    F3D --&gt;|\&quot;score 1.00\&quot;| F3E\n\n    %% ─── CONNECTIONS: FLOW 4 ────────────────────────────────────────────────\n    F4A --&gt;|\&quot;W_avg\&quot;| F4B\n    F4B --&gt;|\&quot;coverage set\&quot;| F4C\n    F4C --&gt;|\&quot;Rᵢ applied\&quot;| F4D\n    F4D --&gt;|\&quot;final premium\&quot;| F4E\n\n    %% ─── CONNECTIONS: FLOW 5 ────────────────────────────────────────────────\n    F3E --&gt;|\&quot;KYC passed\&quot;| F5A\n    F4E --&gt;|\&quot;premium ready\&quot;| F5A\n    F5A --&gt;|\&quot;writes\&quot;| F5B\n    F5A --&gt;|\&quot;activates\&quot;| F5C\n    F5C --&gt;|\&quot;issues cert\&quot;| F5D\n    F5D --&gt;|\&quot;delivered\&quot;| WORKER\n\n    %% ─── CONNECTIONS: FLOW 6 ────────────────────────────────────────────────\n    F6A --&gt;|\&quot;event signal\&quot;| F6C\n    F6B --&gt;|\&quot;event signal\&quot;| F6C\n    F6C --&gt;|\&quot;confirmed ✓\&quot;| F6D\n    F6D --&gt;|\&quot;zone matched\&quot;| F6E\n    F6E --&gt;|\&quot;loss confirmed\&quot;| F7A\n\n    %% ─── CONNECTIONS: FLOW 7 ────────────────────────────────────────────────\n    F7A --&gt;|\&quot;consumes\&quot;| F7B\n    F7B --&gt;|\&quot;actual earnings\&quot;| F7C\n    F7C --&gt;|\&quot;opens shell\&quot;| F7D\n    F7D --&gt;|\&quot;notifies\&quot;| F7E\n    F7E --&gt;|\&quot;alerts\&quot;| WORKER\n    F7C --&gt;|\&quot;passes claim\&quot;| F8A\n\n    %% ─── CONNECTIONS: FLOW 8 ────────────────────────────────────────────────\n    F8A --&gt;|\&quot;spawns parallel\&quot;| A1\n    F8A --&gt;|\&quot;spawns parallel\&quot;| A2\n    F8A --&gt;|\&quot;spawns parallel\&quot;| A3\n    A1 --&gt;|\&quot;GPS verdict\&quot;| F8B\n    A2 --&gt;|\&quot;KYC verdict\&quot;| F8B\n    A3 --&gt;|\&quot;event verdict\&quot;| F8B\n    F8B --&gt;|\&quot;payout amount\&quot;| F8C\n    F8C --&gt;|\&quot;approved\&quot;| F8D\n    F8D --&gt;|\&quot;decision + reason\&quot;| F8E\n    F8E --&gt;|\&quot;authorises\&quot;| F9A\n\n    %% ─── CONNECTIONS: FLOW 9 ────────────────────────────────────────────────\n    F9A --&gt;|\&quot;UPI transfer\&quot;| F9B\n    F9B --&gt;|\&quot;UTR confirmed\&quot;| F9C\n    F9B --&gt;|\&quot;credited\&quot;| BANK\n    F9C --&gt;|\&quot;triggers\&quot;| F9D\n    F9D --&gt;|\&quot;confirms payout\&quot;| WORKER\n    F9C --&gt;|\&quot;closes\&quot;| F9E\n    F9C --&gt;|\&quot;resolves\&quot;| F9F\n\n    %% ─── CROSS-FLOW LINKS ───────────────────────────────────────────────────\n    F1E --&gt;|\&quot;order revenue feeds\&quot;| F2A\n    F2B -.-&gt;|\&quot;uses premium from\&quot;| F4E\n    F2E -.-&gt;|\&quot;same rail as\&quot;| F9A\n\n    %% ─── STYLES ─────────────────────────────────────────────────────────────\n    classDef kafka fill:#DBEAFE,stroke:#2563EB,stroke-width:2px,color:#1B3A6B,font-weight:bold\n    classDef db fill:#CCFBF1,stroke:#0D9488,stroke-width:2px,color:#0D9488\n    classDef guidewire fill:#EDE9FE,stroke:#7C3AED,stroke-width:2px,color:#7C3AED\n    classDef external fill:#FED7AA,stroke:#EA580C,stroke-width:2px,color:#EA580C\n    classDef decision fill:#FEF9C3,stroke:#CA8A04,stroke-width:2px,color:#92400E\n    classDef agent fill:#DCFCE7,stroke:#16A34A,stroke-width:2px,color:#15803D,font-weight:bold\n    classDef actor fill:#1B3A6B,stroke:#1B3A6B,color:#FFFFFF,font-weight:bold\n    classDef notify fill:#FFE4E6,stroke:#E11D48,stroke-width:1px,color:#9F1239\n\n    class F1B,F2D,F5A,F7A kafka\n    class F2C,F5B,F7C,F9C db\n    class F3E,F4E,F5C,F7D,F9E guidewire\n    class F3B,F3C,F9B external\n    class F6C,F8C,F8E decision\n    class A1,A2,A3 agent\n    class CUSTOMER,WORKER,BANK actor\n    class F2F,F7E,F9D notify&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Q2sG6Vm0CMvHczbn6fxa-177">
