# Copy to .env (or export) to override defaults. All values are optional.
GIGINSURE_HOST=127.0.0.1
GIGINSURE_PORT=8000
# real seconds per simulated hour for the trigger monitor
GIGINSURE_TICK_SECONDS=3
# mock (seasonal simulator) | openmeteo (live Open-Meteo weather + air-quality APIs, no key required)
GIGINSURE_WEATHER=mock
# HMAC key for worker session tokens - change in any shared deployment
GIGINSURE_SECRET=dev-secret-change-me
